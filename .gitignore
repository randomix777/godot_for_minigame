# Godot editor cache
.godot/

# Local editor configuration (preserve it, never publish it)
.cursor/

# Godot auto-generated import files
*.import

# Export presets (may contain local paths)
export_presets.cfg

# GDScript UID metadata
*.uid

# OS files
.DS_Store
Thumbs.db

# Build output
/build/
/dist/
/build_wasm/

# Reproduction output (local testing artifacts)
repro_output/

# Memory search index (session-specific)
.memsearch/

# Probe runtime output
probe/probe_report.json

# Node.js
node_modules/

# Wrangler
.wrangler/
